{
  "name": "@synoped/ag-ui-vue",
  "version": "2.0.0",
  "description": "Headless AG-UI protocol integration for Vue 3 — composables, reactive state, frontend tool calling, and a renderer-agnostic chat timeline",
  "license": "MIT",
  "keywords": [
    "ag-ui",
    "agent",
    "vue",
    "vue3",
    "composables",
    "headless",
    "llm",
    "ai",
    "chat",
    "streaming",
    "tool-calling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ieshan/ag-ui-vue.git"
  },
  "homepage": "https://github.com/ieshan/ag-ui-vue#readme",
  "bugs": {
    "url": "https://github.com/ieshan/ag-ui-vue/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@ag-ui/client": "^0.0.59",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@ag-ui/client": "^0.0.59",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "rxjs": "7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
